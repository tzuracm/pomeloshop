# -----------------------------------------------------------------------------
# Pomelo Shop — environment variables
# -----------------------------------------------------------------------------
# Copy this file to `.env.local` (local) and add the same keys in Vercel
# (Project → Settings → Environment Variables).
#
# SUPABASE_URL and SUPABASE_ANON_KEY are safe to expose to the browser: the
# anon key is designed for public clients and is protected by the RLS policies
# in supabase/migrations/.
#
# SUPABASE_SERVICE_ROLE_KEY is SERVER-ONLY. It bypasses RLS and is used by the
# /api/admin/* functions to verify staff roles. NEVER expose it to the browser
# and NEVER commit it. In Vercel, mark it as a "Sensitive" variable.
# -----------------------------------------------------------------------------

# Supabase project URL, e.g. https://abcdefghijklm.supabase.co
SUPABASE_URL=https://YOUR-PROJECT.supabase.co

# Supabase anon/public API key (Project → Settings → API → anon public)
SUPABASE_ANON_KEY=YOUR-ANON-KEY

# Supabase service_role key (Project → Settings → API → service_role).
# SERVER-ONLY. Required by /api/admin/* to read profiles and manage data.
SUPABASE_SERVICE_ROLE_KEY=YOUR-SERVICE-ROLE-KEY

# -----------------------------------------------------------------------------
# Payment configuration
# -----------------------------------------------------------------------------
# There is no PromptPay ID environment variable. The receiving account is
# configured entirely in /admin.html → 收款二维码: the owner uploads the bank's
# receive-money QR, the server validates the EMVCo payload, and the confirmed
# payload is stored in `pomelo_settings.promptpay_qr_payload`.
#
# Until a QR is confirmed, the storefront reports that payment is unavailable
# and blocks checkout.
# -----------------------------------------------------------------------------

# Display name shown on the shop page
SHOP_NAME=Pomelo Shop
